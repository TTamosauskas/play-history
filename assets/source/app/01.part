/* Catalog selection, UI modes and year picker. */
function stableHue(text, offset = 0){
  let h = 2166136261;
  for (let i = 0; i < text.length; i++){
    h ^= text.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return Math.abs(h + offset) % 360;
}

