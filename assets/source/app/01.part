function chronologicalSort(a,b){
  return a.year - b.year ||
    (a.yearPriority ?? 999) - (b.yearPriority ?? 999) ||
    (a.decadeRank ?? 999) - (b.decadeRank ?? 999) ||
    a.artist.localeCompare(b.artist, "pt-BR") ||
    a.title.localeCompare(b.title, "pt-BR");
}

const INTERNATIONAL_CATALOG = CATALOG
  .filter(track => track.catalogSource !== "brazil")
  .slice()
  .sort(chronologicalSort);

const BRAZILIAN_CATALOG = CATALOG
  .filter(track => track.catalogSource === "brazil")
  .slice()
  .sort(chronologicalSort);

