function nearestPlayableTrack(referenceTrack){
  if (!CHRONOLOGICAL_CATALOG.length) return null;
  const referenceYear = Number(referenceTrack?.year || yearInput.value || DEFAULT_PICKER_YEAR);
  const referenceSource = referenceTrack?.catalogSource || null;
  const candidates = CHRONOLOGICAL_CATALOG.filter(track => {
    const id = hydrateCachedYoutubeId(track);
    return Boolean(id);
  });
  if (!candidates.length) return null;

  let best = candidates[0];
  let bestScore = Infinity;
  for (const candidate of candidates){
    const yearDistance = Math.abs(Number(candidate.year) - referenceYear);
    const sourcePenalty = catalogMode === "combined" && referenceSource && candidate.catalogSource !== referenceSource ? 0.4 : 0;
    const score = yearDistance + sourcePenalty;
    if (score < bestScore || (score === bestScore && Number(candidate.year) < Number(best.year))){
      best = candidate;
      bestScore = score;
    }
  }
  return best;
}

async function resolveMusicBrainzYoutubeId(track){
  const key = trackIdentity(track);
  if (musicBrainzYoutubeCache.has(key)) return musicBrainzYoutubeCache.get(key);
  let resolved = null;
  try {
    const recording = await resolveMusicBrainzRecording(track);
    if (recording?.id){
      const api = new URL(`https://musicbrainz.org/ws/2/recording/${encodeURIComponent(recording.id)}`);
      api.searchParams.set("inc", "url-rels");
      api.searchParams.set("fmt", "json");
      const data = await fetchJson(api.toString(), 3000);
      const relations = Array.isArray(data?.relations) ? data.relations : [];
      const ranked = relations
        .map(relation => {
          const resource = relation?.url?.resource || "";
          const videoId = extractYoutubeVideoId(resource);
          if (!videoId || failedYoutubeIds.has(videoId)) return null;
          const attrs = (relation?.attributes || []).map(normalizeSearchText).join(" ");
          const type = normalizeSearchText(relation?.type || "");
          let score = 120;
          if (/free streaming|streaming/.test(type)) score += 12;
          if (/video/.test(attrs)) score += 8;
          if (/music\.youtube\.com/.test(resource)) score += 5;
          return {videoId, score};
        })
        .filter(Boolean)
        .sort((a,b) => b.score - a.score);
      resolved = ranked[0]?.videoId || null;
    }
  } catch (_) {}
  musicBrainzYoutubeCache.set(key, resolved);
  return resolved;
}

async function searchYoutubeEndpoint(endpoint, query, source){
  try {
    const api = new URL(endpoint);
    api.searchParams.set("q", query);
    if (source === "piped") api.searchParams.set("filter", "videos");
    else api.searchParams.set("type", "video");
    const data = await fetchJson(api.toString(), 3000);
    const rows = source === "piped"
      ? (Array.isArray(data?.items) ? data.items : (Array.isArray(data) ? data : []))
      : (Array.isArray(data) ? data : []);
    return rows.slice(0, 12)
      .map(raw => normalizedYoutubeCandidate(raw, source))
      .filter(Boolean);
  } catch (_) {
    return [];
  }
}

async function searchYoutubeResolverWave(track, query){
  if (!query) return [];
  const jobs = [
    ...PIPED_SEARCH_ENDPOINTS.map(endpoint => searchYoutubeEndpoint(endpoint, query, "piped")),
    ...INVIDIOUS_SEARCH_ENDPOINTS.map(endpoint => searchYoutubeEndpoint(endpoint, query, "invidious"))
  ];
  const settled = await Promise.allSettled(jobs);
  return settled.flatMap(result => result.status === "fulfilled" ? result.value : []);
}

function bestYoutubeCandidate(candidates, track){
  let best = null;
  for (const candidate of candidates){
    if (!candidate?.videoId || failedYoutubeIds.has(candidate.videoId)) continue;
    const score = youtubeCandidateScore(candidate, track);
    if (!best || score > best.score) best = {...candidate, score};
  }
  return best;
}

async function resolveTrackYoutubeId(track){
  if (!track) return null;
  if (track.youtubeId && !failedYoutubeIds.has(track.youtubeId)) return track.youtubeId;
  const key = trackIdentity(track);
  const cached = cachedYoutubeIdForTrack(track);
  if (cached) {
    track.youtubeId = cached;
    track.youtubeUrl = `https://www.youtube.com/watch?v=${cached}`;
    track.youtubeMusicUrl = `https://music.youtube.com/watch?v=${cached}`;
    return cached;
  }
  if (youtubeResolutionInFlight.has(key)) return youtubeResolutionInFlight.get(key);

  const task = (async () => {
    const queries = youtubeQueriesForTrack(track);
    let best = null;

    // Run independent sources together. This caps first playback latency instead
    // of waiting through every public API timeout one after another.
    const firstQuery = queries[0] || `${track.artist} ${track.title}`;
    const mbPromise = resolveMusicBrainzYoutubeId(track).catch(() => null);
    const [mbResult, firstWave] = await Promise.all([
      Promise.race([
        mbPromise,
        new Promise(resolve => setTimeout(() => resolve(null), 3000))
      ]),
      searchYoutubeResolverWave(track, firstQuery)
    ]);

    if (mbResult && !failedYoutubeIds.has(mbResult)){
      best = {videoId:mbResult, source:"musicbrainz", score:145};
    }
    const waveBest = bestYoutubeCandidate(firstWave, track);
    if (waveBest && (!best || waveBest.score > best.score)) best = waveBest;

    // Keep foreground resolution within the browser's user-activation window.
    // If the public search sources are slow, playback falls back immediately
    // to another already-playable track from the selected catalog.
    const resolvedId = best && best.score >= 74 ? best.videoId : null;
    if (resolvedId){
      persistYoutubeIdForTrack(track, resolvedId);
      track.youtubeId = resolvedId;
      track.youtubeUrl = `https://www.youtube.com/watch?v=${resolvedId}`;
      track.youtubeMusicUrl = `https://music.youtube.com/watch?v=${resolvedId}`;
      track.videoStatus = `runtime_resolved_${best.source || "search"}`;
      track.videoValidationClass = best.score >= 108 ? "runtime_hq_confident" : "runtime_hq_best_match";
    }
    return resolvedId;
  })().finally(() => youtubeResolutionInFlight.delete(key));
