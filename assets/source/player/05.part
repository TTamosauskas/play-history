  if (activePlayerIndex !== null && readyPlayerSlots.has(activePlayerIndex)){
    return activePlayerIndex;
  }

  for (const candidate of readyPlayerSlots) return candidate;
  return -1;
}

function playlistTracksForCurrent(){
  if (!queue.length) return [];
  const currentTrack = queue[currentIndex];
  if (!currentTrack) return [];
  if (repeatOne) return [currentTrack];

  if (playbackDirection < 0){
    const backwardToStart = queue.slice(0, currentIndex + 1).reverse();
    const wrappedTail = queue.slice(currentIndex + 1).reverse();
    return backwardToStart.concat(wrappedTail);
  }

  return queue.slice(currentIndex).concat(queue.slice(0, currentIndex));
}

function playlistShouldLoop(){
  if (repeatOne) return true;
  return queue.length > 1;
}

function setPlaybackEngine(engine){
  playbackEngine = engine === "legacy" ? "legacy" : "playlist";
  document.documentElement.dataset.playbackEngine = playbackEngine;
}

function clearPlaylistWatchdog(){
  if (playlistWatchdog){
    clearTimeout(playlistWatchdog);
    playlistWatchdog = null;
  }
}

function legacyActivateCurrentTrack(autoplay = true, startSeconds = 0, selectionToken = playbackSelectionSerial){
  warmStandaloneActive = false;
  const track = queue[currentIndex];
  if (!track || selectionToken !== playbackSelectionSerial || !trackBelongsToActiveCatalog(track)) return;
  activePlaybackSelectionSerial = selectionToken;
  expectedActiveVideoId = track.youtubeId || null;

  desiredPlaying = Boolean(autoplay);
  pendingPlay = Boolean(autoplay) && !readyPlayerSlots.size;
  setPlayingUI(Boolean(autoplay) && readyPlayerSlots.size > 0);

  if (!readyPlayerSlots.size){
    refreshPreloadWindow();
    return;
  }

  const previousPlayer = player;
  const previousSlot = activePlayerIndex;
  const targetSlot = choosePlayerForTrack(track);
  if (targetSlot < 0) return;

  if (previousPlayer && previousSlot !== targetSlot){
    try { previousPlayer.pauseVideo?.(); } catch (_) {}
    try { previousPlayer.mute?.(); } catch (_) {}
  }

  activePlayerIndex = targetSlot;
  player = players[targetSlot];
  playerReady = Boolean(player);

  try { player.unMute?.(); } catch (_) {}

  const alreadyLoaded = loadedVideoIds[targetSlot] === track.youtubeId;
  try {
    if (!alreadyLoaded || startSeconds > 0){
      loadedVideoIds[targetSlot] = track.youtubeId;
      const payload = {videoId: track.youtubeId, startSeconds: Math.max(0, Number(startSeconds) || 0)};
      if (autoplay) player.loadVideoById(payload);
      else player.cueVideoById(payload);
    } else if (autoplay){
      player.playVideo();
    } else {
      player.pauseVideo?.();
    }
  } catch (_) {}

  pendingPlay = false;
  refreshPreloadWindow();
}

function fallbackToLegacy(reason = "playlist indisponível"){
  if (playbackEngine === "legacy") return;
  const activeTime = (() => {
    try { return Math.max(0, Number(player?.getCurrentTime?.()) || 0); } catch (_) { return 0; }
  })();
  const wasPlaying = (() => {
    try { return player?.getPlayerState?.() === YT.PlayerState.PLAYING || desiredPlaying; } catch (_) { return desiredPlaying; }
  })();

  clearPlaylistWatchdog();
  setPlaybackEngine("legacy");
  setStatus(`Mecanismo de playlist indisponível (${reason}). Reprodução contínua mantida pelo modo compatível.`);
  legacyActivateCurrentTrack(Boolean(wasPlaying), activeTime, playbackSelectionSerial);
}

function loadDirectionalPlaylist(autoplay = true, startSeconds = 0){
  if (!player || activePlayerIndex === null) return false;
  const tracks = playlistTracksForCurrent();
  const ids = tracks.map(track => track.youtubeId).filter(Boolean);
  const currentTrack = queue[currentIndex];
  if (!ids.length || !currentTrack?.youtubeId) return false;

  const serial = ++playlistLoadSerial;
  clearPlaylistWatchdog();

  try {
    loadedVideoIds[activePlayerIndex] = currentTrack.youtubeId;
    player.setLoop?.(playlistShouldLoop());
    if (autoplay){
      player.loadPlaylist(ids, 0, Math.max(0, Number(startSeconds) || 0));
      if (selectedTrackMustPlayFirstId === trackIdentity(currentTrack)){
        setTimeout(() => {
          try { player?.playVideoAt?.(0); } catch (_) {}
        }, 120);
      }
    } else {
      player.cuePlaylist(ids, 0, Math.max(0, Number(startSeconds) || 0));
    }
  } catch (error) {
    fallbackToLegacy("falha ao carregar a fila");
    return false;
  }

  playlistWatchdog = setTimeout(() => {
    if (serial !== playlistLoadSerial || effectivePlaybackEngine() !== "playlist" || !player) return;
    let playlistIds = [];
    let activeId = "";
    try { playlistIds = player.getPlaylist?.() || []; } catch (_) {}
    try { activeId = player.getVideoData?.()?.video_id || ""; } catch (_) {}
    const hasUsablePlaylist = ids.length <= 1
      ? activeId === currentTrack.youtubeId || playlistIds.length >= 1
      : playlistIds.length >= 2;
    if (!hasUsablePlaylist) fallbackToLegacy("fila interna não confirmada");
  }, 10000);

  return true;
}

function playlistActivateCurrentTrack(autoplay = true, startSeconds = 0, selectionToken = playbackSelectionSerial){
  warmStandaloneActive = false;
  const track = queue[currentIndex];
  if (!track || selectionToken !== playbackSelectionSerial || !trackBelongsToActiveCatalog(track)) return;
  activePlaybackSelectionSerial = selectionToken;
  expectedActiveVideoId = track.youtubeId || null;

  desiredPlaying = Boolean(autoplay);
  pendingPlay = Boolean(autoplay) && !readyPlayerSlots.size;
  setPlayingUI(Boolean(autoplay) && readyPlayerSlots.size > 0);

  if (!readyPlayerSlots.size){
    refreshPreloadWindow();
    return;
  }

  let targetSlot = activePlayerIndex;
  if (targetSlot === null || !readyPlayerSlots.has(targetSlot)){
    targetSlot = choosePlayerForTrack(track);
  }
  if (targetSlot < 0 || targetSlot === null) return;

  if (player && activePlayerIndex !== targetSlot){
    try { player.pauseVideo?.(); } catch (_) {}
    try { player.mute?.(); } catch (_) {}
  }

  activePlayerIndex = targetSlot;
  player = players[targetSlot];
  playerReady = Boolean(player);
  try { player.unMute?.(); } catch (_) {}
