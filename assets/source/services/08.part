|| 0);
    return duration >= 1 && duration <= 3600 ? duration : 0;
  } catch (_) {
    return 0;
  }
}

function lrclibGetUrl(track, duration){
  const api = new URL("https://lrclib.net/api/get");
  api.searchParams.set("track_name", track.title);
  api.searchParams.set("artist_name", track.artist);
  const album = track.albumTitle || track.preferredAlbumTitle || "";
  if (album) api.searchParams.set("album_name", album);
  if (duration > 0) api.searchParams.set("duration", String(duration));
  return api.toString();
}

function lrclibSearchUrl(track){
  const api = new URL("https://lrclib.net/api/search");
  api.searchParams.set("track_name", track.title);
  api.searchParams.set("artist_name", track.artist);
  const album = track.albumTitle || track.preferredAlbumTitle || "";
  if (album) api.searchParams.set("album_name", album);
  return api.toString();
}

function validateLyricsRecord(record, track, duration){
  if (!record) return null;
  const score = lrclibRecordScore(record, track, duration);
  if (score.titleScore < .58 || score.artistScore < .42 || score.total < 66) return null;
  if (!record.instrumental && !lyricsTextFromRecord(record)) return null;
  return record;
}

async function resolveLyrics(track){
  const key = trackIdentity(track);
  if (lyricsCache.has(key)) return lyricsCache.get(key);

  const task = (async () => {
    const duration = currentPlaybackDuration();
    const cachedId = storedLyricsId(track);
    if (cachedId){
      try {
        const cached = await fetchLrclibJson(`https://lrclib.net/api/get/${cachedId}`);
        const validated = validateLyricsRecord(cached, track, duration);
        if (validated) return validated;
        clearStoredLyricsId(track);
      } catch (_) {}
    }

    try {
      const exact = await fetchLrclibJson(lrclibGetUrl(track, duration));
      const validated = validateLyricsRecord(exact, track, duration);
      if (validated){
        storeLyricsId(track, validated.id);
        return validated;
      }
    } catch (error) {
      if (String(error?.message || "") === "LRCLIB_RATE_LIMIT") throw error;
    }

    const results = await fetchLrclibJson(lrclibSearchUrl(track));
    if (!Array.isArray(results) || !results.length) return null;
    const ranked = results
      .map(record => ({record, score: lrclibRecordScore(record, track, duration)}))
      .filter(item => item.score.titleScore >= .58 && item.score.artistScore >= .42)
      .sort((a,b) => b.score.total - a.score.total);
    const best = ranked[0];
    if (!best || best.score.total < 66) return null;
    const validated = validateLyricsRecord(best.record, track, duration);
    if (!validated) return null;
    storeLyricsId(track, validated.id);
    return validated;
  })();

  lyricsCache.set(key, task);
  try {
    const result = await task;
    lyricsCache.set(key, result);
    return result;
  } catch (error) {
    lyricsCache.delete(key);
    throw error;
  }
}

function appendContextSection(heading, result, fallbackMessage, actionLabel){
  const section = document.createElement("section");
  section.className = "context-section";

  const title = document.createElement("h3");
  title.className = "context-section-title";
  title.textContent = heading;
  section.appendChild(title);

  if (result?.title || result?.contextLabel){
    const meta = document.createElement("p");
    meta.className = "context-section-meta";
    meta.textContent = [result?.contextLabel, result?.title].filter(Boolean).join(" · ");
    section.appendChild(meta);
  }

  const copy = document.createElement("p");
  copy.className = result?.extract ? "context-summary" : "context-message";
  copy.textContent = result?.extract ? trimContextExcerpt(result.extract) : fallbackMessage;
  section.appendChild(copy);

  if (result?.url){
    const link = document.createElement("a");
    link.className = "context-action context-section-action";
    link.href = result.url;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.textContent = actionLabel;
    section.appendChild(link);
  }

  contextDialogBody.appendChild(section);
}

async function openCulturalContextForTrack(track){
  if (!track) return;
  const token = openContextDialog("Contexto", track);
  try {
    const [culturalState, aboutState] = await Promise.allSettled([
      resolveWikipediaCulturalContext(track),
      resolveWikipediaSummary(track)
    ]);
    if (token !== contextRenderToken || !contextTrackIsCurrent(track)) return;

    const cultural = culturalState.status === "fulfilled" ? culturalState.value : null;
    const about = aboutState.status === "fulfilled" ? aboutState.value : null;

    contextDialogKicker.textContent = "Contexto";
    contextDialogTitle.textContent = track.title;
    contextDialogSubtitle.textContent = `${track.artist} · ${track.year}`;
    contextDialogBody.replaceChildren();
    contextDialogActions.replaceChildren();

    appendContextSection(
      "Contexto",
      cultural,
      "Nenhum dos títulos enciclopédicos direcionados para subgênero, gênero, movimento ou período forneceu texto.",
      cultural ? wikipediaCulturalActionLabel(cultural.contextKind) : "Wikipedia ↗"
    );
    appendContextSection(
      "Sobre",
      about,
      "Nenhum dos títulos enciclopédicos direcionados para a faixa ou o artista forneceu texto.",
      about ? wikipediaActionLabel(about.contextKind) : "Wikipedia ↗"
    );
  } catch (_) {
    if (token !== contextRenderToken) return;
    setContextMessage("As fontes enciclopédicas estão temporariamente indisponíveis.");
    setContextActions([]);
  }
}

async function openLyricsForTrack(track){
  if (!track) return;
  if (shouldHideLyrics(track)) return;
  const token = openContextDialog("Letra", track);
  try {
    const result = await resolveLyrics(track);
    if (token !== contextRenderToken || !contextTrackIsCurrent(track)) return;
    if (result?.instrumental){
      hideTrackAction(lyricsLink);
      setContextMessage("Faixa instrumental.");
      setContextActions([]);
      return;
    }
    const lyrics = lyricsTextFromRecord(result);
    if (!lyrics){
      setContextMessage("Letra indisponível nesta fonte.");
      setContextActions([{label:"Buscar letra no Google ↗", url:googleLyricsSearchUrl(track)}]);
      return;
    }
    setContextText(lyrics, "context-lyrics");
    setContextActions([{label:"LRCLIB ↗", url:"https://lrclib.net"}]);
  } catch (error) {
    if (token !== contextRenderToken) return;
    const rateLimited = String(error?.message || "") === "LRCLIB_RATE_LIMIT";
    setContextMessage(rateLimited ? "O serviço de letras está ocupado neste momento." : "A fonte de letras está temporariamente indisponível.");
    setContextActions([{label:"Buscar letra no Google ↗", url:googleLyricsSearchUrl(track)}]);
  }
}

async function openAlbumForTrack(track){
  if (!track) return;

  if (track.albumUrl){
    window.open(track.albumUrl, "_blank", "noopener,noreferrer");
    return;
  }
  if (track.albumTitle && !albumTitleLooksLikeCompilation(track.albumTitle)){
    window.open(youtubeMusicAlbumSearchUrl(track, track.albumTitle), "_blank", "noopener,noreferrer");
    return;
  }

  const token = openContextDialog("Álbum", track);
  try {
    const result = await resolvePreferredAlbumLink(track);
    if (token !== contextRenderToken || !contextTrackIsCurrent(track)) return;
    if (!result?.url){
      setContextMessage("Álbum específico indisponível para esta gravação.");
      setContextActions([]);
      return;
    }
    const detail = result.title ? `Álbum identificado: ${result.title}.` : "Álbum identificado para esta gravação.";
    setContextMessage(detail);
    setContextActions([{label:"Abrir no YouTube Music ↗", url:result.url}]);
  } catch (_) {
    if (token !== contextRenderToken) return;
    setContextMessage("A resolução do álbum está temporariamente indisponível.");
    setContextActions([]);
  }
}
