roupId)}`);
    api.searchParams.set("inc", "url-rels");
    api.searchParams.set("fmt", "json");
    const data = await fetchJson(api.toString(), 6000);
    const relations = Array.isArray(data?.relations) ? data.relations : [];
    for (const relation of relations){
      const resource = relation?.url?.resource || "";
      try {
        const parsed = new URL(resource);
        if (parsed.hostname === "music.youtube.com" && (/^\/browse\//.test(parsed.pathname) || /^\/playlist/.test(parsed.pathname))){
          resolved = parsed.toString();
          break;
        }
      } catch (_) {}
    }
  } catch (_) {}
  musicBrainzReleaseGroupCache.set(releaseGroupId, resolved);
  return resolved;
}

function youtubeMusicAlbumSearchUrl(track, albumTitle){
  if (!albumTitle) return null;
  const query = `${track.artist} ${albumTitle}`.trim();
  return `https://music.youtube.com/search?q=${encodeURIComponent(query)}`;
}

async function resolvePreferredAlbumLink(track){
  const key = trackIdentity(track);
  if (preferredAlbumCache.has(key)) return preferredAlbumCache.get(key);

  const task = (async () => {
    // Explicit catalog album link wins. This keeps artwork/album/link changes synchronized.
    if (track.albumTitle && track.albumUrl && !albumTitleLooksLikeCompilation(track.albumTitle)){
      return {
        title: track.albumTitle,
        url: track.albumUrl,
        direct: /^https:\/\/music\.youtube\.com\/(?:browse\/|playlist)/.test(track.albumUrl),
        source: "catalog_explicit"
      };
    }

    // Curated catalog metadata wins when the source explicitly supplies the original album.
    if (track.albumTitle && !albumTitleLooksLikeCompilation(track.albumTitle)){
      return {
        title: track.albumTitle,
        url: youtubeMusicAlbumSearchUrl(track, track.albumTitle),
        direct: false,
        source: "catalog"
      };
    }

    // First network choice: an official original album associated with this exact recording.
    const mbAlbum = await resolveMusicBrainzAlbum(track);
    if (mbAlbum?.title){
      const directUrl = await resolveYoutubeMusicAlbumUrlFromMusicBrainz(mbAlbum.releaseGroupId);
      return {
        title: mbAlbum.title,
        url: directUrl || youtubeMusicAlbumSearchUrl(track, mbAlbum.title),
        direct: Boolean(directUrl),
        source: "musicbrainz"
      };
    }

    // Fallback: Genius often exposes the canonical album attached to the song.
    const geniusMetadata = await resolveGeniusMetadata(track);
    const geniusAlbum = await resolveGeniusAlbumName(geniusMetadata);
    if (geniusAlbum && !albumTitleLooksLikeCompilation(geniusAlbum)){
      return {
        title: geniusAlbum,
        url: youtubeMusicAlbumSearchUrl(track, geniusAlbum),
        direct: false,
        source: "genius"
      };
    }

    return null;
  })();

  preferredAlbumCache.set(key, task);
  const result = await task;
  preferredAlbumCache.set(key, result);
  return result;
}

